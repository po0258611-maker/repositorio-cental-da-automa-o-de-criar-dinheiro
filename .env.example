# ============================================
# AUTONOMOUS MONEY ENGINE - AME
# Configuração Central - Copie para .env e preencha
# NUNCA commitar .env com secrets reais
# ============================================

# --- CORE ---
AME_ENV=development
AME_SECRET_KEY=change-me-to-32-chars-random-string
AME_DEBUG=true
DATABASE_URL=sqlite:///./ame.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/ame

# --- SECURITY ---
JWT_SECRET=change-me-jwt-secret-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
API_RATE_LIMIT=100
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8001

# --- IA ROUTER (LLM_PROVIDER) ---
OPENAI_API_KEY=sk-proj-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...
GROQ_API_KEY=...
# Custo máximo por dia em USD (survival mode)
AME_MAX_DAILY_AI_COST_USD=10.00
AME_DEFAULT_CHEAP_MODEL=gpt-4o-mini
AME_DEFAULT_POWER_MODEL=gpt-4o
AME_DEFAULT_FAST_MODEL=gemini-1.5-flash

# --- IMAGE / VIDEO / DOCUMENT PROVIDERS ---
REPLICATE_API_KEY=
STABILITY_API_KEY=
ELEVENLABS_API_KEY=
CLOUDINARY_URL=

# --- BOTS & COMUNICAÇÃO ---
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_ID=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
SLACK_WEBHOOK_URL=

# --- AFILIADOS & VENDAS ---
HOTMART_CLIENT_ID=
HOTMART_CLIENT_SECRET=
KIWIFY_API_KEY=
EDUZZ_API_KEY=
AMAZON_AFILIADO_TAG=seutag-20
SHOPEE_AFILIADO_ID=
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=
KIWIFY_WEBHOOK_SECRET=
GUMROAD_TOKEN=

# --- REDES SOCIAIS (DISTRIBUIÇÃO) ---
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
TIKTOK_SESSION_ID=
PINTEREST_TOKEN=
YOUTUBE_API_KEY=
TWITTER_API_KEY=
TWITTER_API_SECRET=

# --- EMAIL MARKETING ---
GMAIL_USER=seuemail@gmail.com
GMAIL_APP_PASSWORD=
BREVO_API_KEY=
MAILCHIMP_API_KEY=
RESEND_API_KEY=

# --- PLANILHAS E STORAGE ---
GOOGLE_SHEETS_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=ame-storage
AWS_REGION=us-east-1

# --- BROWSER AUTOMATION ---
BROWSER_HEADLESS=true
BROWSER_TIMEOUT=30000

# --- FINANCEIRO (ECONOMIC ENGINE) ---
AME_INITIAL_BALANCE=1000.00
AME_BURN_RATE_DAILY=5.00
AME_SURVIVAL_THRESHOLD_DAYS=7
AME_EMERGENCY_THRESHOLD_DAYS=3

# --- OBSERVABILITY ---
LOG_LEVEL=INFO
SENTRY_DSN=
ENABLE_METRICS=true

# --- SYSTEM ---
TZ=America/Sao_Paulo
GENERIC_TIMEZONE=America/Sao_Paulo
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=central123

# --- LEGACY (compat) ---
MODO_TESTE=true
CANAL_TELEGRAM=@seucanal
LINK_WHATSAPP=https://wa.me/5571...

# ============================================
# AUTONOMOUS MONEY ENGINE - AME
# Exemplo de configuração. Nunca coloque secrets reais aqui.
# ============================================
AME_ENV=development
AME_DEBUG=false
DATABASE_URL=sqlite:///./ame.db
AME_SECRET_KEY=replace-with-a-random-32-byte-secret
JWT_SECRET=replace-with-a-random-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
API_RATE_LIMIT=100
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
AME_RESEARCH_PROVIDER=tavily
AME_ALLOW_MOCKS=true
AME_REAL_EXECUTION=false
AME_MAX_DAILY_AI_COST_USD=10.00

REPLICATE_API_KEY=
STABILITY_API_KEY=
ELEVENLABS_API_KEY=
CLOUDINARY_URL=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_ID=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

HOTMART_CLIENT_ID=
HOTMART_CLIENT_SECRET=
KIWIFY_API_KEY=
EDUZZ_API_KEY=
AMAZON_AFILIADO_TAG=
SHOPEE_AFILIADO_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
KIWIFY_WEBHOOK_SECRET=
GUMROAD_TOKEN=

INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
TIKTOK_SESSION_ID=
PINTEREST_TOKEN=
YOUTUBE_API_KEY=
TWITTER_API_KEY=
TWITTER_API_SECRET=

GMAIL_USER=
GMAIL_APP_PASSWORD=
BREVO_API_KEY=
MAILCHIMP_API_KEY=
RESEND_API_KEY=

GOOGLE_SHEETS_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1

BROWSER_HEADLESS=true
BROWSER_TIMEOUT=30000

AME_INITIAL_BALANCE=1000.00
AME_BURN_RATE_DAILY=5.00
AME_SURVIVAL_THRESHOLD_DAYS=7
AME_EMERGENCY_THRESHOLD_DAYS=3

LOG_LEVEL=INFO
SENTRY_DSN=
ENABLE_METRICS=true
AME_WORKER_POLL_SECONDS=2
AME_WORKER_BATCH_SIZE=5
TZ=America/Sao_Paulo
GENERIC_TIMEZONE=America/Sao_Paulo

# n8n credentials: REQUIRED in the runtime environment; no defaults here.
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=
